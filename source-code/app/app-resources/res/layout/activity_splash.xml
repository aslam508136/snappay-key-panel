<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/splash_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_alignParentTop="true"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginBottom="18dp"
            android:src="@drawable/snapay"
            android:scaleType="fitCenter"
            android:contentDescription="SnapPay logo"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snap"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#8b80d8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pay"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:background="#4a3f8a"
                android:layout_width="40dp"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#9b92d0"
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Automated Payment Assistant  "/>
            <View
                android:background="#4a3f8a"
                android:layout_width="40dp"
                android:layout_height="1dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/imgWave"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/splash_wave"
        android:scaleType="fitXY"
        android:layout_below="@+id/layoutTop"
        android:contentDescription=""/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_below="@+id/imgWave">
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:indeterminateTint="#7b72c0"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#9b92d0"
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="80dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/ic_shield_check"
                    android:scaleType="fitCenter"
                    android:contentDescription="Secure"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#9b92d0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Secure"/>
            </LinearLayout>
            <View
                android:background="@drawable/splash_divider_v"
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="80dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/ic_lightning"
                    android:scaleType="fitCenter"
                    android:contentDescription="Fast"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#9b92d0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fast"/>
            </LinearLayout>
            <View
                android:background="@drawable/splash_divider_v"
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="80dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="6dp"
                    android:src="@drawable/ic_shield"
                    android:scaleType="fitCenter"
                    android:contentDescription="Reliable"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#9b92d0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reliable"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#6b62c0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powered by SnapPay"/>
    </LinearLayout>
    <TextView
        android:id="@+id/txtWelcome"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <TextView
        android:id="@+id/txtTo"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <TextView
        android:id="@+id/txtAppName"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <LinearLayout
        android:id="@+id/neonContainer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
</RelativeLayout>
