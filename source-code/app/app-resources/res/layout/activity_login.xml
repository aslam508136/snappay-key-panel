<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/login_bg_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingBottom="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/snapay"
            android:scaleType="fitCenter"
            android:contentDescription="SnapPay logo"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1a1446"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snap"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#4c3fc1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pay"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <View
                android:background="#c0bbee"
                android:layout_width="36dp"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#7b72c0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Automated Payment Assistant  "/>
            <View
                android:background="#c0bbee"
                android:layout_width="36dp"
                android:layout_height="1dp"/>
        </LinearLayout>
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1a1446"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Welcome Back!"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#7b72c0"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:text="Login to manage your payments\10smarter and faster"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="15sp"
                android:textColor="#1a1446"
                android:textColorHint="#9990c8"
                android:id="@+id/edtAccessKey"
                android:background="@drawable/btn_login_outline"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Enter your access key"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="52dp"/>
            <ImageButton
                android:id="@+id/btnPasteKey"
                android:background="@android:color/transparent"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_paste"
                android:scaleType="centerInside"
                android:tint="#4c3fc1"
                android:layout_centerVertical="true"
                android:contentDescription="Paste from clipboard"
                android:layout_marginEnd="4dp"
                android:layout_alignParentEnd="true"/>
            <ImageButton
                android:id="@+id/btnToggleKeyVisibility"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="Toggle visibility"/>
        </RelativeLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#e53935"
            android:gravity="center"
            android:id="@+id/txtError"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <Button
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/btnLogin"
            android:background="@drawable/btn_login_primary"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:text="Login"
            android:elevation="4dp"
            android:stateListAnimator="@null"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/device_id_card_bg"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#4c3fc1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Your Device ID"
                    android:layout_weight="1"/>
                <ImageButton
                    android:id="@+id/btnCopyDeviceId"
                    android:background="@android:color/transparent"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_copy"
                    android:scaleType="centerInside"
                    android:tint="#4c3fc1"
                    android:contentDescription="Copy Device ID"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#1a1446"
                android:id="@+id/txtDeviceId"
                android:background="#f5f3ff"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="monospace"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#9990c8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Click copy icon to copy."/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <TextView
                android:textSize="13sp"
                android:textColor="#9990c8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Don&apos;t have a key?"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#4c3fc1"
                android:id="@+id/txtGetSubscription"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get Subscription"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">
            <TextView
                android:textSize="12sp"
                android:textColor="#9990c8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure. Fast. Reliable."/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#4c3fc1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Powered by SnapPay"/>
    </LinearLayout>
</ScrollView>
