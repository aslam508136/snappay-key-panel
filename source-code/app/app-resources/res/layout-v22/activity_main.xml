<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/login_bg_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <View
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="6dp">
            <TextView
                android:textSize="11sp"
                android:textColor="#9990c8"
                android:id="@+id/txtAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v—"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1a1446"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SnapPay"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/countdown_background"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_shield_check"
                    android:scaleType="fitCenter"
                    android:contentDescription="Expiry"
                    android:layout_marginEnd="4dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="8sp"
                        android:textColor="#9990c8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expires in"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#4c3fc1"
                        android:id="@+id/txtSubscriptionCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="#9990c8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="SUPPORTED APP"
            android:letterSpacing="0.1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/container_bg"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp">
                <View
                    android:background="@drawable/phonepe_circle_bg"
                    android:layout_width="34dp"
                    android:layout_height="34dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/phonepe_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="PhonePe"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1a1446"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PhonePe"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#9990c8"
                    android:id="@+id/txtSelectedApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default"/>
            </LinearLayout>
            <TextView
                android:textSize="18sp"
                android:textColor="#9990c8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"/>
            <Button
                android:id="@+id/btnPhonePe"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/containerAppMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#9990c8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="APP MODE"
                android:letterSpacing="0.1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/btnUpiAutopay"
                    android:background="@drawable/btn_upi_autopay"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_upi_autopay"
                        android:scaleType="fitCenter"
                        android:contentDescription=""
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1a1446"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPI AUTOPAY"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/btnQrScanner"
                    android:background="@drawable/btn_qr_scanner_selected"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_qr_scanner"
                        android:scaleType="fitCenter"
                        android:contentDescription=""
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#4c3fc1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QR SCANNER"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/statusContainer"
            android:background="@drawable/container_bg"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#4c3fc1"
                    android:id="@+id/txtStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="● Standby"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#9990c8"
                    android:id="@+id/txtWatching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not-Watching"/>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="#f59e0b"
                android:id="@+id/txtAutopayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="⚡ Autopay Inactive"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="9sp"
                        android:textColor="#9990c8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LAST"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#4c3fc1"
                        android:id="@+id/txtLast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0ms"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="9sp"
                        android:textColor="#9990c8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1a1446"
                        android:id="@+id/txtTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="9sp"
                        android:textColor="#9990c8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVG"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#22c55e"
                        android:id="@+id/txtAvg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0ms"/>
                </LinearLayout>
            </LinearLayout>
            <Button
                android:textSize="11sp"
                android:textColor="#9990c8"
                android:layout_gravity="center"
                android:id="@+id/btnResetStats"
                android:background="@drawable/btn_login_outline"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Reset Stats"
                android:stateListAnimator="@null"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/containerUpiPin"
            android:background="@drawable/container_bg"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1a1446"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="��  UPI PIN · PhonePe"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#22c55e"
                    android:id="@+id/txtPinSaved"
                    android:background="@drawable/pin_saved_bg"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ PIN SAVED"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">
                    <EditText
                        android:textSize="13sp"
                        android:textColor="#1a1446"
                        android:textColorHint="#9990c8"
                        android:id="@+id/edtUpiPin"
                        android:background="@drawable/edit_text_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="••••"
                        android:maxLength="6"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:paddingEnd="40dp"/>
                    <ImageButton
                        android:id="@+id/btnTogglePinVisibility"
                        android:background="@null"
                        android:padding="5dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_eye_closed"
                        android:scaleType="centerInside"
                        android:tint="#9990c8"
                        android:layout_centerVertical="true"
                        android:contentDescription="Toggle PIN visibility"
                        android:layout_marginEnd="3dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <Button
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnSavePin"
                    android:background="@drawable/btn_login_outline"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Update"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="#ef4444"
                android:id="@+id/txtBankWarning"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Select bank first to enter UPI pin"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/containerBankSelection"
            android:background="@drawable/container_bg"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#9990c8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="PREFERRED BANK"
                    android:layout_weight="1"
                    android:letterSpacing="0.1"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#9990c8"
                    android:id="@+id/txtSelectedBank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp">
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnSbi"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="SBI"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnPnb"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="PNB"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnBob"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="BOB"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnCb"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="CB"
                    android:layout_weight="1"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp">
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnUbi"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="UBI"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnIb"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="IB"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnBoi"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="BOI"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnCbi"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="CBI"
                    android:layout_weight="1"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp">
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnIob"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="IOB"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnUco"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="UCO"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnBom"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="BOM"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnPsb"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="PSB"
                    android:layout_weight="1"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnHdfc"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="HDFC"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnIcici"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="ICICI"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnAxis"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="AXIS"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnOther"
                    android:background="@drawable/btn_bank"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:text="Other"
                    android:layout_weight="1"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="#9990c8"
                android:id="@+id/txtBankNote"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Note: If you don&apos;t select a bank, the top bank PhonePe shows will be used as the payment bank."/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/containerPaymentMode"
            android:background="@drawable/container_bg"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#9990c8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="PAYMENT MODE"
                android:letterSpacing="0.1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/btnPayAll"
                    android:background="@drawable/btn_pay_all_selected"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_pay_all"
                        android:scaleType="fitCenter"
                        android:contentDescription=""
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1a1446"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAY ALL"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/btnOneTime"
                    android:background="@drawable/btn_one_time_selected"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_one_time"
                        android:scaleType="fitCenter"
                        android:contentDescription=""
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#4c3fc1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ONE TIME"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnActivateAutopay"
                    android:background="@drawable/btn_login_primary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:text="⚡  Activate Autopay"
                    android:layout_weight="1"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnOpenPhonePe"
                    android:background="@drawable/btn_login_primary"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:text="Open PhonePe"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/container_bg"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1a1446"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accessibility Service"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#f59e0b"
                        android:id="@+id/txtAccessibilityStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="● Inactive"/>
                </LinearLayout>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnSettings"
                    android:background="@drawable/btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Settings"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
            <View
                android:background="#e8e8f0"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1a1446"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display Over Apps"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#f59e0b"
                        android:id="@+id/txtOverlayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="● Inactive"/>
                </LinearLayout>
                <Button
                    android:textSize="11sp"
                    android:textColor="#4c3fc1"
                    android:id="@+id/btnOverlaySettings"
                    android:background="@drawable/btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Enable"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/container_bg"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#9990c8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="LOGS"
                    android:layout_weight="1"
                    android:letterSpacing="0.1"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#9990c8"
                    android:id="@+id/btnCopyLogs"
                    android:background="@drawable/btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="COPY"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#9990c8"
                    android:id="@+id/btnClearLogs"
                    android:background="@drawable/btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="CLEAR"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/logScrollView"
                android:background="@drawable/log_console_bg"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:fillViewport="true"
                android:fadeScrollbars="true"
                android:overScrollMode="never"
                android:clipToOutline="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/logContainer"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
